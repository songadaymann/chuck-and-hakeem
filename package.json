{
  "name": "chuck-and-hakeem",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite build && wrangler dev --port 8787",
    "deploy": "vite build && wrangler deploy",
    "loadtest": "node tools/loadtest.mjs",
    "assets:sync": "node scripts/assets.mjs sync",
    "assets:check": "node scripts/assets.mjs check",
    "assets:add": "node scripts/assets.mjs add",
    "assets:update": "node scripts/assets.mjs update",
    "assets:status": "node scripts/assets.mjs status",
    "predev": "node scripts/assets.mjs sync --quiet",
    "pretest": "node scripts/assets.mjs sync --quiet && node scripts/assets.mjs check",
    "prebuild": "node scripts/assets.mjs sync --quiet",
    "postbuild": "node scripts/assets.mjs verify-build dist --when-required"
  },
  "dependencies": {
    "@fontsource/rubik-dirt": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "vite": "^5.4.0",
    "wrangler": "^4.160.0",
    "ws": "^8.18.0"
  }
}
